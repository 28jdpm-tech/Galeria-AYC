<HTA:APPLICATION ID="oHTA" />
<script>
window.onerror = function(msg, url, line, col, error) {
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var f = fso.CreateTextFile("error.txt", true);
        f.WriteLine(msg + " at " + line + ":" + col);
        f.Close();
    } catch(e) {}
    window.close();
}
</script>
<script src="js/app.js"></script>
<script>
    try {
        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var f = fso.CreateTextFile("error.txt", true);
        f.WriteLine("No syntax error!");
        f.Close();
    } catch(e) {}
    window.close();
</script>
